{
  "name": "vue-flexible-table",
  "version": "1.0.0",
  "description": "A flexible Vue 3 table component.",
  "author": "Stefan Peters",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbv/vue-flexible-table.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/FlexibleTable.vue",
    "src/index.js"
  ],
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./style": "./dist/style.css",
    "./build": "./dist/vue-flexible-table.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "BUILD_MODE=app vite build && vite preview",
    "test": "npm run lint",
    "e2e": "playwright test",
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "release": "test $(git rev-parse --abbrev-ref HEAD) = main && git pull && npm version $SEMVER && git push --follow-tags",
    "release:patch": "SEMVER=patch npm run release",
    "release:minor": "SEMVER=minor npm run release",
    "release:major": "SEMVER=major npm run release",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix"
    ],
    "src/*.{js,vue}": [
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.0.0",
    "eslint-config-gbv": "^2.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "vite": "^8.0.0",
    "vue": "3.5.41",
    "vue-flexible-table": "file:."
  }
}
