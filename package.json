{
  "name": "vue-flexible-table",
  "version": "1.0.0",
  "description": "A flexible Vue 3 table component.",
  "author": "Stefan Peters",
  "repository": {
    "type": "git",
    "url": "https://github.com/gbv/vue-flexible-table.git"
  },
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src/FlexibleTable.vue",
    "src/index.js"
  ],
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./style": "./dist/style.css",
    "./build": "./dist/vue-flexible-table.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-app": "BUILD_MODE=app vite build",
    "app": "BUILD_MODE=app vite build && vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",    
    "lint": "eslint",
    "fix": "eslint --fix",
    "lint-staged": "lint-staged",
    "release": "test $(git rev-parse --abbrev-ref HEAD) = dev && git pull && npm test && npm run build && npm version $SEMVER && npm run --silent yesno && (git push && git checkout main && git merge dev && git push --follow-tags && git checkout dev) || (git tag -d $(git describe --tags) && git reset --hard HEAD~1)",
    "release:patch": "SEMVER=patch npm run release",
    "release:minor": "SEMVER=minor npm run release",
    "release:major": "SEMVER=major npm run release",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "src/**/*.{js,vue}": [
      "eslint --fix"
    ],
    "src/*.{js,vue}": [
      "eslint --fix"
    ]
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.0.0",
    "eslint-config-gbv": "^2.7.0",
    "happy-dom": "^20.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "vue": "3.5.41",
    "vue-flexible-table": "file:."
  }
}
